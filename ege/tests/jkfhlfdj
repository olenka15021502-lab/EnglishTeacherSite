function wavBlob(samples,sampleRate){const buf=new ArrayBuffer(44+samples.length*2),v=new DataView(buf);function str(p,s){for(let i=0;i<s.length;i++)v.setUint8(p+i,s.charCodeAt(i));}str(0,'RIFF');v.setUint32(4,36+samples.length*2,true);str(8,'WAVE');str(12,'fmt ');v.setUint32(16,16,true);v.setUint16(20,1,true);v.setUint16(22,1,true);v.setUint32(24,sampleRate,true);v.setUint32(28,sampleRate*2,true);v.setUint16(32,2,true);v.setUint16(34,16,true);str(36,'data');v.setUint32(40,samples.length*2,true);for(let i=0;i<samples.length;i++){const x=Math.max(-1,Math.min(1,samples[i]));v.setInt16(44+i*2,x<0?x*32768:x*32767,true);}return new Blob([buf],{type:'audio/wav'});}
async function convertToMp3(blob){const ctx=new (window.AudioContext||window.webkitAudioContext)();try{const data=await blob.arrayBuffer(),decoded=await ctx.decodeAudioData(data);const rate=44100,offline=new OfflineAudioContext(1,Math.ceil(decoded.duration*rate),rate);const src=offline.createBufferSource();src.buffer=decoded;src.connect(offline.destination);src.start();const pcm=(await offline.startRendering()).getChannelData(0);if(typeof lamejs==='undefined')return {blob:wavBlob(pcm,rate),ext:'wav',warning:'MP3-кодировщик не загрузился. Сохранён совместимый WAV-файл; для MP3 открой страницу с доступом к интернету.'};const encoder=new lamejs.Mp3Encoder(1,rate,96),chunks=[],step=1152;for(let i=0;i<pcm.length;i+=step){const end=Math.min(pcm.length,i+step),ints=new Int16Array(end-i);for(let j=i;j<end;j++){const x=Math.max(-1,Math.min(1,pcm[j]));ints[j-i]=x<0?x*32768:x*32767;}const part=encoder.encodeBuffer(ints);if(part.length)chunks.push(new Uint8Array(part));if(i%(step*150)===0)await new Promise(r=>setTimeout(r,0));}const end=encoder.flush();if(end.length)chunks.push(new Uint8Array(end));return {blob:new Blob(chunks,{type:'audio/mpeg'}),ext:'mp3'};}finally{await ctx.close();}}
function controls(id,enabled){$('start'+id).disabled=enabled;$('stop'+id).disabled=!enabled;$('download'+id).disabled=enabled||!records[id]?.blob;}
async function start(id){if(active.id!==null){alert('Сначала заверши текущую запись.');return;}if(!navigator.mediaDevices?.getUserMedia){setStatus(id,'Запись недоступна: открой сайт по HTTPS или в поддерживаемом браузере.');return;}const interview=id===3?new Audio($('interview').src):null;let mic;try{mic=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});}catch(e){setStatus(id,'Нет доступа к микрофону. Проверь разрешения браузера.');return;}
let ctx,recorder,output,source;try{ctx=new (window.AudioContext||window.webkitAudioContext)();await ctx.resume();output=ctx.createMediaStreamDestination();const micSource=ctx.createMediaStreamSource(mic);micSource.connect(output);if(interview){interview.currentTime=0;source=ctx.createMediaElementSource(interview);source.connect(output);source.connect(ctx.destination);}const preferred=['audio/webm;codecs=opus','audio/mp4','audio/webm'].find(x=>MediaRecorder.isTypeSupported(x));recorder=new MediaRecorder(output.stream,preferred?{mimeType:preferred}:undefined);}catch(e){mic.getTracks().forEach(t=>t.stop());if(ctx)await ctx.close();setStatus(id,'Этот браузер не поддерживает запись или смешивание звука. Попробуй Chrome, Edge или Safari.');return;}
const chunks=[];active.id=id;controls(id,true);$('preview'+id).style.display='none';$('download'+id).style.display='none';records[id]=null;setStatus(id,'Идёт запись…');recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};
recorder.onstop=async()=>{if(interview){interview.pause();interview.onended=null;}mic.getTracks().forEach(t=>t.stop());const raw=new Blob(chunks,{type:recorder.mimeType||'audio/webm'});await ctx.close();setStatus(id,'Обрабатываем запись… Это может занять некоторое время.');try{const result=await convertToMp3(raw);records[id]=result;const url=URL.createObjectURL(result.blob);result.url=url;$('preview'+id).src=url;$('preview'+id).style.display='block';$('download'+id).style.display='inline-block';$('download'+id).textContent='Скачать '+result.ext.toUpperCase();setStatus(id,'Запись готова. '+(result.warning||'Можешь прослушать её или записать заново.'));}catch(e){setStatus(id,'Не удалось обработать запись. Попробуй другой браузер. '+e.message);}active.id=null;controls(id,false);updateSummary();};
try{recorder.start(250);active.recorder=recorder;if(interview){interview.onended=()=>stop(id);await interview.play();}}catch(e){if(recorder.state!=='inactive')recorder.stop();setStatus(id,'Не удалось запустить аудио: '+e.message);}}
function stop(id){if(active.id!==id)return;const r=active.recorder;if(r&&r.state!=='inactive')r.stop();$('stop'+id).disabled=true;setStatus(id,'Завершаем запись…');}
function download(id){const r=records[id];if(!r?.blob)return;const a=document.createElement('a');a.href=r.url;a.download=nameFor(id,r.ext);document.body.appendChild(a);a.click();a.remove();}
