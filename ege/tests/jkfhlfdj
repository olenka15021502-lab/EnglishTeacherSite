function crc32(bytes){let c=0xffffffff;for(const b of bytes){c^=b;for(let j=0;j<8;j++)c=(c>>>1)^((c&1)?0xedb88320:0);}return (c^0xffffffff)>>>0;}
function zipArchive(files){const encoder=new TextEncoder(),parts=[],directory=[];let offset=0;const u16=(v,n)=>n.setUint16(0,v,true),u32=(v,n)=>n.setUint32(0,v>>>0,true);function header(length,write){const a=new Uint8Array(length);write(new DataView(a.buffer));return a;}for(const file of files){const name=encoder.encode(file.name),bytes=file.bytes,crc=crc32(bytes),size=bytes.length;const local=header(30,v=>{v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint16(6,0x0800,true);v.setUint16(8,0,true);v.setUint32(14,crc,true);v.setUint32(18,size,true);v.setUint32(22,size,true);v.setUint16(26,name.length,true);});parts.push(local,name,bytes);const entry=header(46,v=>{v.setUint32(0,0x02014b50,true);v.setUint16(4,20,true);v.setUint16(6,20,true);v.setUint16(8,0x0800,true);v.setUint32(16,crc,true);v.setUint32(20,size,true);v.setUint32(24,size,true);v.setUint16(28,name.length,true);v.setUint32(42,offset,true);});directory.push(entry,name);offset+=local.length+name.length+size;}const dirSize=directory.reduce((n,b)=>n+b.length,0);const end=header(22,v=>{v.setUint32(0,0x06054b50,true);v.setUint16(8,files.length,true);v.setUint16(10,files.length,true);v.setUint32(12,dirSize,true);v.setUint32(16,offset,true);});return new Blob([...parts,...directory,end],{type:'application/zip'});}
